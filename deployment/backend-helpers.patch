@@ -0,0 +1,29 @@
+package me.kavin.piped.utils;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+
+/** Private helper calls must bypass the residential proxy used for YouTube requests. */
+final class HelperHttpClient {
+    private static final HttpClient CLIENT = HttpClient.newBuilder()
+            .connectTimeout(Duration.ofSeconds(10)).build();
+
+    static CompletableFuture<HttpResponse<byte[]>> fetch(String url, String method, byte[] body,
+                                                          Map<String, String> headers) {
+        var request = HttpRequest.newBuilder(URI.create(url)).timeout(Duration.ofSeconds(30));
+        headers.forEach(request::header);
+        request.method(method, body == null ? HttpRequest.BodyPublishers.noBody()
+                : HttpRequest.BodyPublishers.ofByteArray(body));
+        return CLIENT.sendAsync(request.build(), HttpResponse.BodyHandlers.ofByteArray())
+                .thenApply(response -> {
+                    if (response.statusCode() != 200)
+                        throw new IllegalStateException("Helper returned HTTP " + response.statusCode());
+                    return response;
+                });
+    }
+}
